{
  "name": "coc-vscode-loader",
  "private": true,
  "description": "Monorepo for running VS Code extensions in coc.nvim",
  "scripts": {
    "build:plugin": "cd plugin && npm run build",
    "build:converter": "cd converter && npm run build",
    "build": "npm run build:converter && npm run build:plugin",
    "switch:local": "bash switch.sh local",
    "switch:npm": "bash switch.sh npm",
    "switch:status": "bash switch.sh status"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coc-plugin/coc-vscode-loader.git"
  },
  "bugs": {
    "url": "https://github.com/coc-plugin/coc-vscode-loader/issues"
  },
  "homepage": "https://www.npmjs.com/package/coc-vscode-loader",
  "license": "MIT"
}
