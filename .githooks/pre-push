#!/bin/sh
# Pre-push hook: run unit tests + registry smoke test before pushing.
# Skip with: git push --no-verify

set -e

cd "$(git rev-parse --show-toplevel)"

echo "=== Unit tests ==="
if [ -f converter/package.json ]; then
  cd converter
  npm test
  cd ..
fi

if [ -z "$SKIP_SMOKE" ]; then
  echo ""
  echo "=== Registry smoke test ==="
  if [ -f converter/package.json ]; then
    cd converter
    npm run test:smoke
    cd ..
  fi
else
  echo ""
  echo "=== Registry smoke test SKIPPED (SKIP_SMOKE=1) ==="
fi

echo ""
echo "All tests passed."
